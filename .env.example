# ===========================================
# LLM Provider API Keys
# ===========================================

# Google Gemini (default provider)
# Prod usa GEMINI_BACKEND=vertex (auth via ADC do service account — sem key);
# a GEMINI_API_KEY abaixo é o fallback do modo aistudio (default local).
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# Default Configuration
# ===========================================

# Default LLM provider (so `gemini` e registrado no factory)
DEFAULT_PROVIDER=gemini

# Modelo: nao ha env. Cada agent le o seu papel em garantis_shared.llm_models.

# Default prompt version
DEFAULT_PROMPT_VERSION=v3

# ===========================================
# API Configuration
# ===========================================

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

